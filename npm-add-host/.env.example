# npm_add_host.py — Environment Variables
#
# Copy this file to one of the locations the script searches (first match
# wins for each variable; real environment variables always win over files):
#   1. --env-file /path/to/file
#   2. /etc/npm-add-host/env     (recommended for a shared host: mode 600,
#                                 owned by the user that runs the script)
#   3. .env next to the script
#
# This file holds a login, so keep it out of git (".env" is already in the
# repo .gitignore) and chmod 600 it.

# --- Required ---
# Base URL of the NPM admin API (the admin UI port, not a proxied hostname).
NPM_URL=http://npm.example.lan:81
# Login of a dedicated NPM user for this script (not your personal account).
NPM_EMAIL=
NPM_PASSWORD=
# Hostnames passed to `add` must already resolve to NPM (e.g. a wildcard DNS
# record), or the HTTP-01 challenge will fail.
# Default upstream host/IP that new proxy hosts forward to (needed by `add`).
NPM_FORWARD_HOST=192.0.2.10

# --- Safety ---
# Friendly names for access lists, as name=<numeric id> pairs. NPM does not
# enforce unique list names, so aliases give --access-list an unambiguous
# handle (e.g. --access-list internal).
# NPM_ACCESS_LIST_ALIASES=internal=1,external=2
# Access list applied when --access-list is not given (alias, name or id).
# If neither this nor --access-list is set, the script refuses to create a
# host unless --public is passed.
# NPM_ACCESS_LIST=

# --- Optional (defaults shown) ---
# NPM_FORWARD_SCHEME=http
# Let's Encrypt registration email (defaults to NPM_EMAIL).
# NPM_LE_EMAIL=
# NPM_WEBSOCKETS=true
# NPM_HSTS=true
# NPM_BLOCK_EXPLOITS=true
# NPM_HTTP2=true
# NPM_CACHING=false
