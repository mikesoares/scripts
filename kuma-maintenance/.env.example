# kuma_maintenance.py — environment variables
#
# Copy this file to .env next to the script (or to /etc/kuma-maintenance/env,
# mode 600) and fill in your values. The script auto-loads it; use --env-file
# for another location. Variables already set in the shell take precedence.

# Required. Comma-separated name=url entries, one per Uptime Kuma instance.
# KUMA_INSTANCES=main=http://kuma-a.example:3001,remote=http://kuma-b.example:3001
KUMA_INSTANCES=

# Required. A web-UI login that exists on every instance listed above.
# API keys do not work: they only authorise /metrics, not maintenance.
KUMA_USER=
KUMA_PASS=

# Optional. Name of the monitor tag used to select monitors (default: host).
# KUMA_TAG_NAME=host
